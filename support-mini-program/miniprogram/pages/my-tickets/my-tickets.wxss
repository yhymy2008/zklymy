/* 工单列表样式 */
.filter-bar {
  display: flex;
  overflow-x: auto;
  white-space: nowrap;
  margin: 10rpx 0 20rpx;
  padding: 10rpx 0;
  gap: 12rpx;
}

.filter-tab {
  flex-shrink: 0;
  padding: 12rpx 24rpx;
  border-radius: 30rpx;
  font-size: 24rpx;
  color: #5a6a7a;
  background: rgba(13, 31, 53, 0.8);
  border: 1px solid #1e3050;
  display: flex;
  align-items: center;
  gap: 8rpx;
  transition: all 0.3s;
}

.filter-tab.active {
  color: #00d4ff;
  border-color: #00d4ff44;
  background: rgba(0, 212, 255, 0.08);
}

.tab-dot {
  width: 10rpx;
  height: 10rpx;
  border-radius: 50%;
}

.pending-dot { background: #f59e0b; }
.processing-dot { background: #00d4ff; }
.resolved-dot { background: #10b981; }

.search-bar {
  position: relative;
  margin-bottom: 20rpx;
}

.search-input {
  background: #1a2744;
  border: 1px solid #1e3050;
  border-radius: 30rpx;
  padding: 16rpx 24rpx 16rpx 60rpx;
  font-size: 26rpx;
  color: #e0e8f0;
  width: 100%;
  box-sizing: border-box;
}

.search-icon {
  position: absolute;
  left: 20rpx;
  top: 50%;
  transform: translateY(-50%);
  font-size: 28rpx;
  opacity: 0.5;
}

/* 工单卡片 */
.ticket-card {
  cursor: pointer;
}

.ticket-card.ticket-urgent {
  border-color: rgba(239, 68, 68, 0.3);
}

.ticket-card.ticket-high {
  border-color: rgba(245, 158, 11, 0.2);
}

.ticket-header {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  margin-bottom: 16rpx;
}

.ticket-no-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
  flex-wrap: wrap;
}

.ticket-no {
  font-size: 24rpx;
  color: #00d4ff;
  font-family: 'Courier New', monospace;
  letter-spacing: 1rpx;
}

.ticket-time {
  font-size: 22rpx;
  color: #5a6a7a;
}

.ticket-title {
  display: block;
  font-size: 30rpx;
  font-weight: 600;
  color: #e0e8f0;
  margin-bottom: 12rpx;
  line-height: 1.4;
}

.ticket-desc {
  display: block;
  font-size: 24rpx;
  color: #5a6a7a;
  line-height: 1.6;
  margin-bottom: 16rpx;
}

.ticket-footer {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.ticket-meta {
  display: flex;
  gap: 20rpx;
}

.meta-category, .meta-handler {
  font-size: 22rpx;
  color: #5a6a7a;
}

.rating-stars {
  display: flex;
  gap: 4rpx;
}

.star {
  font-size: 28rpx;
  color: #f59e0b;
}

.star.empty {
  color: #2a3a4a;
}
