/* 工单管理页样式 */
.filter-bar {
  display: flex;
  overflow-x: auto;
  white-space: nowrap;
  margin: 10rpx 0 20rpx;
  padding: 10rpx 0;
  gap: 12rpx;
}

.filter-tab {
  flex-shrink: 0;
  padding: 12rpx 24rpx;
  border-radius: 30rpx;
  font-size: 24rpx;
  color: #5a6a7a;
  background: rgba(13, 31, 53, 0.8);
  border: 1px solid #1e3050;
  transition: all 0.3s;
}

.filter-tab.active {
  color: #00d4ff;
  border-color: #00d4ff44;
  background: rgba(0, 212, 255, 0.08);
}

.search-bar {
  position: relative;
  margin-bottom: 20rpx;
}

.search-input {
  background: #1a2744;
  border: 1px solid #1e3050;
  border-radius: 30rpx;
  padding: 16rpx 24rpx 16rpx 60rpx;
  font-size: 26rpx;
  color: #e0e8f0;
  width: 100%;
  box-sizing: border-box;
}

.search-icon {
  position: absolute;
  left: 20rpx;
  top: 50%;
  transform: translateY(-50%);
  font-size: 28rpx;
  opacity: 0.5;
}

.ticket-card {
  position: relative;
}

.card-click-area {
  cursor: pointer;
}

.ticket-header {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  margin-bottom: 14rpx;
}

.tk-left {
  display: flex;
  align-items: center;
  gap: 12rpx;
  flex-wrap: wrap;
}

.ticket-no {
  font-size: 24rpx;
  color: #00d4ff;
  font-family: 'Courier New', monospace;
}

.ticket-time {
  font-size: 20rpx;
  color: #5a6a7a;
  flex-shrink: 0;
}

.ticket-title {
  display: block;
  font-size: 28rpx;
  font-weight: 600;
  color: #e0e8f0;
  margin-bottom: 12rpx;
}

.ticket-meta {
  display: flex;
  gap: 20rpx;
  font-size: 22rpx;
  color: #5a6a7a;
  flex-wrap: wrap;
  margin-bottom: 16rpx;
}

.quick-actions {
  display: flex;
  gap: 16rpx;
  padding-top: 16rpx;
  border-top: 1px solid #1e3050;
}

.quick-actions .btn-sm {
  flex: 1;
  text-align: center;
}
