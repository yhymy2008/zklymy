/* 首页样式 */
.page {
  min-height: 100vh;
}

/* 英雄区域 */
.hero-section {
  position: relative;
  padding: 40rpx 0 20rpx;
  overflow: hidden;
}

.hero-glow {
  position: absolute;
  top: -100rpx;
  right: -100rpx;
  width: 400rpx;
  height: 400rpx;
  background: radial-gradient(circle, rgba(0,212,255,0.1) 0%, transparent 70%);
  border-radius: 50%;
}

.hero-content {
  display: flex;
  align-items: center;
  justify-content: space-between;
  position: relative;
  z-index: 1;
}

.user-info {
  display: flex;
  align-items: center;
  gap: 20rpx;
}

.avatar {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #00d4ff, #7c3aed);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 36rpx;
  font-weight: 700;
  color: #fff;
}

.user-detail {
  display: flex;
  flex-direction: column;
  gap: 6rpx;
}

.greeting {
  font-size: 24rpx;
  color: #5a6a7a;
}

.user-name {
  font-size: 36rpx;
  font-weight: 700;
  color: #e0e8f0;
}

.role-tag {
  margin-top: 4rpx;
}

.notify-btn {
  position: relative;
  width: 80rpx;
  height: 80rpx;
  background: rgba(0,212,255,0.08);
  border: 1px solid #1e3050;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
}

.icon-bell {
  font-size: 36rpx;
}

.badge {
  position: absolute;
  top: -4rpx;
  right: -4rpx;
  min-width: 32rpx;
  height: 32rpx;
  background: #ef4444;
  border-radius: 16rpx;
  color: #fff;
  font-size: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0 8rpx;
}

/* 统计卡片 */
.stats-row {
  display: flex;
  gap: 16rpx;
  margin: 20rpx 0;
  flex-wrap: wrap;
}

.stat-card {
  flex: 1;
  min-width: 140rpx;
  background: rgba(13, 31, 53, 0.8);
  border: 1px solid #1e3050;
  border-radius: 16rpx;
  padding: 24rpx;
  text-align: center;
  position: relative;
  overflow: hidden;
}

.stat-card.active {
  border-color: #00d4ff44;
}

.stat-num {
  display: block;
  font-size: 48rpx;
  font-weight: 700;
  background: linear-gradient(180deg, #00d4ff, #667eea);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  line-height: 1.2;
}

.stat-label {
  display: block;
  font-size: 22rpx;
  color: #5a6a7a;
  margin-top: 8rpx;
}

.stat-bar {
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  height: 4rpx;
}

/* 趋势图 */
.trend-card {
  margin-top: 0;
}

.card-title {
  display: flex;
  align-items: center;
  gap: 12rpx;
  font-size: 28rpx;
  font-weight: 600;
  margin-bottom: 24rpx;
  color: #00d4ff;
}

.trend-total {
  margin-left: auto;
  font-size: 22rpx;
  font-weight: 400;
  color: #5a6a7a;
  background: rgba(0, 212, 255, 0.08);
  padding: 4rpx 16rpx;
  border-radius: 20rpx;
}

.title-icon {
  font-size: 28rpx;
}

.chart-container {
  padding: 10rpx 0;
}

.bar-chart {
  display: flex;
  align-items: flex-end;
  justify-content: space-around;
  height: 200rpx;
  gap: 8rpx;
}

.bar-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 6rpx;
}

.bar-count {
  font-size: 20rpx;
  font-weight: 600;
  color: #00d4ff;
  min-height: 28rpx;
  line-height: 28rpx;
}

.bar {
  width: 40rpx;
  border-radius: 6rpx 6rpx 0 0;
  min-height: 8rpx;
  transition: all 0.3s;
}

.bar-date {
  font-size: 18rpx;
  color: #5a6a7a;
}

/* 快捷操作 */
.actions-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 20rpx;
}

.action-btn {
  background: rgba(0, 212, 255, 0.05);
  border: 1px solid #1e3050;
  border-radius: 14rpx;
  padding: 28rpx 20rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 12rpx;
  transition: all 0.3s;
}

.action-btn:active {
  background: rgba(0, 212, 255, 0.1);
  border-color: #00d4ff44;
  transform: scale(0.97);
}

.action-icon {
  font-size: 44rpx;
}

.action-text {
  font-size: 24rpx;
  color: #8899aa;
}

/* 登录页面 */
.login-container {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding-top: 120rpx;
}

.login-header {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-bottom: 60rpx;
}

.logo-icon {
  width: 120rpx;
  height: 120rpx;
  position: relative;
  margin-bottom: 30rpx;
}

.logo-ring {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  border: 3rpx solid;
  border-color: #00d4ff44;
  animation: spin 4s linear infinite;
}

.logo-inner {
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  width: 60rpx;
  height: 60rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #00d4ff, #7c3aed);
  box-shadow: 0 0 40rpx rgba(0, 212, 255, 0.4);
}

@keyframes spin {
  from { transform: rotate(0deg); }
  to { transform: rotate(360deg); }
}

.app-title {
  font-size: 44rpx;
  font-weight: 700;
  background: linear-gradient(180deg, #00d4ff, #7c3aed);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  letter-spacing: 4rpx;
}

.app-subtitle {
  font-size: 24rpx;
  color: #5a6a7a;
  letter-spacing: 6rpx;
  margin-top: 8rpx;
}

.login-card {
  width: 100%;
  max-width: 600rpx;
}

.form-title {
  display: block;
  text-align: center;
  font-size: 32rpx;
  font-weight: 600;
  color: #e0e8f0;
  margin-bottom: 40rpx;
}

.login-tips {
  background: rgba(0, 212, 255, 0.05);
  border: 1px solid #1e3050;
  border-radius: 8rpx;
  padding: 16rpx 20rpx;
  margin-bottom: 30rpx;
}

.login-tips text {
  display: block;
  font-size: 22rpx;
  color: #5a6a7a;
  line-height: 1.6;
}

.btn-primary {
  width: 100%;
  margin-top: 10rpx;
}

.switch-link {
  display: block;
  text-align: center;
  margin-top: 30rpx;
  font-size: 26rpx;
  color: #00d4ff;
}
